# ==============================================================================
# SmartProcure - Local Development Environment Variables (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to '.env' in the project root:
#      Copy-Item .env.example .env
# 2. Update DB_PASSWORD with your local development password.
# 3. DO NOT commit '.env' to Git (it is ignored in .gitignore).
# ==============================================================================

# Database Connection (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/smartprocure_db?currentSchema=smartprocure
DB_USERNAME=smartprocure_app
DB_PASSWORD=your_secure_local_password_here

# PostgreSQL Client Configuration (for psql / scripts)
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartprocure_db
PGUSER=smartprocure_app
PGOPTIONS=--search_path=smartprocure

# Spring Boot Application Settings
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Java Home (Eclipse Temurin JDK 21 LTS)
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.101-hotspot
