# ==========================================
# SmartProcure - Git Ignore Rules
# ==========================================

# Environment variables & secrets (NEVER COMMIT REAL SECRETS)
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
credentials.json
pgpass.conf

# Java & Build Outputs
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven
.mvn/timing.properties

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Frontend / Node.js
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/coverage/
frontend/.cache/

# OS Specific files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# Temporary files & Scratch
scratch/
tmp/
temp/
